{
  "name": "mikmaster",
  "private": true,
  "version": "0.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "preview": "vite preview",
    "server": "node server/src/index.ts",
    "sim": "node server/src/sim/cli.ts",
    "test:server": "node --test server/test/*.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "pnpm build && node server/src/index.ts --open",
    "sim:mac-alias": "sudo ifconfig lo0 alias 127.0.0.21 up && sudo ifconfig lo0 alias 127.0.0.22 up && sudo ifconfig lo0 alias 127.0.0.23 up && sudo ifconfig lo0 alias 127.0.0.24 up",
    "test:e2e": "playwright test",
    "serve": "node server/src/index.ts --open",
    "build:exe": "pnpm build && node scripts/build-exe.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.6"
  }
}
